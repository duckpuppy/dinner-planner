# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=file:./data/dinner.db

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Refresh token lifetime for the native (Capacitor) app; sliding, extended on every refresh
JWT_REFRESH_EXPIRY_NATIVE=30d

# Initial admin user (only used on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# CORS - comma-separated list of allowed origins (a single value also works).
# Add https://localhost to allow the native Capacitor app, e.g.
# CORS_ORIGIN=https://dinner.example.com,https://localhost
CORS_ORIGIN=http://localhost:5173

# Video & LLM Configuration (optional)
# OLLAMA_URL=http://192.168.0.250:11434    # Ollama instance URL
# OLLAMA_MODEL=gemma4-e4b                  # Default Ollama model
# OLLAMA_NUM_CTX=4096                      # Context window (tokens) per call; raise (e.g. 8192) for long transcripts if VRAM allows
# OLLAMA_KEEP_ALIVE=5m                     # How long Ollama keeps the model loaded after a call (-1 = forever)
# OLLAMA_TEMPERATURE=0                     # Sampling temperature for recipe extraction
# LLM_MODE=disabled                        # disabled | direct | n8n
# N8N_WEBHOOK_URL=                         # n8n webhook URL (when LLM_MODE=n8n)
# VIDEO_STORAGE_LIMIT_MB=10240             # Max video storage in MB (default 10GB)
# VIDEO_IMPORT_COMMENTS=false              # true: also fetch up to 30 comments (YouTube only; yt-dlp has no TikTok comment support) and feed the uploader's own comments + top comments to recipe extraction
